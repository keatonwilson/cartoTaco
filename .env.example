VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_MAPBOX_KEY=your_mapbox_api_key

# AI concierge (server-only; never prefix with VITE_). Used by /api/agent,
# pnpm eval and pnpm agent:chat.
ANTHROPIC_API_KEY=your_anthropic_api_key
# Per-user daily token budget for /api/agent (default 200000)
# AI_DAILY_TOKENS=200000

# LangSmith: traces every concierge run, and makes pnpm eval sync the golden
# set to a dataset and run each config as an experiment. Optional; without a
# key, evals run locally.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=cartotaco-local
# LANGSMITH_DATASET=cartotaco-concierge-golden
# On Vercel set LANGSMITH_TRACING_BACKGROUND=false so traces flush before the
# serverless function freezes

# The culinary knowledgebase (cocina, its own Supabase project): describe_dish
# reads its published cards. Server-only, anon key (published rows only).
# Without these, dish questions get "no entry yet".
# KB_URL=https://<cocina-project>.supabase.co
# KB_ANON_KEY=your_cocina_anon_key

# Optional per-tier model overrides (defaults in src/lib/server/agent/models.js)
# AGENT_ROUTER_MODEL=claude-haiku-4-5
# AGENT_MODEL=claude-haiku-4-5
# AGENT_ESCALATION_MODEL=claude-sonnet-5-5
