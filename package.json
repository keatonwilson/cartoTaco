{
	"name": "cartotaco",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"eval": "node --env-file-if-exists=.env evals/run.js",
		"agent:chat": "node --env-file-if-exists=.env evals/chat.js",
		"eval:fixture": "node --env-file-if-exists=.env evals/refresh-fixture.js",
		"eval:kb-fixture": "sh -c 'case \"$0\" in kb-*) ;; *) echo \"usage: pnpm eval:kb-fixture kb-YYYY.MM.DD\" >&2; exit 1;; esac; t=$(mktemp -d) && gh release download \"$0\" -R keatonwilson/cocina -p \"*.jsonl\" -D \"$t\" && rm -f evals/fixtures/kb-*.jsonl && mv \"$t\"/*.jsonl evals/fixtures/'",
		"eval:sync": "node --env-file-if-exists=.env evals/sync-dataset.js"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^5.10.3",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"autoprefixer": "^10.4.19",
		"postcss": "^8.4.38",
		"svelte": "^4.2.7",
		"svelte-check": "^3.6.0",
		"tailwindcss": "^3.4.4",
		"typescript": "^5.0.0",
		"vite": "^5.0.3",
		"vitest": "^4.0.18"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/outfit": "^5.2.8",
		"@langchain/anthropic": "^1.6.0",
		"@langchain/core": "^1.3.0",
		"@supabase/ssr": "^0.8.0",
		"@supabase/supabase-js": "^2.95.3",
		"echarts": "^5.5.0",
		"langsmith": "^0.11.1",
		"mapbox-gl": "^3.4.0",
		"phosphor-svelte": "^2.0.1",
		"svelte-dnd-action": "^0.9.69",
		"zod": "^4.6.7"
	}
}
